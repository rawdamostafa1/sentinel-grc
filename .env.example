MONGO_URL=mongodb://localhost:27017
MONGO_DB=sentinel

# W4: how often the risks are recalculated automatically (seconds, 0 = off) and how far back incidents count (days)
RECALC_INTERVAL_SECONDS=300
RECALC_WINDOW_DAYS=30

# used by grc_client (other services): where the GRC API is
GRC_URL=http://grc:8001
